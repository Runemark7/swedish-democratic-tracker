{
  "name": "riksdagskollen",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "generate:api": "openapi-typescript ../api/openapi.yaml -o src/shared/api-contract.ts",
    "sync:data-sources": "node scripts/sync-data-sources.mjs",
    "verify:sources": "node scripts/verify-sources.mjs",
    "test:scripts": "node --test scripts/__tests__/*.test.mjs",
    "predev": "npm run sync:data-sources",
    "prebuild": "npm run sync:data-sources"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.74.4",
    "gray-matter": "^4.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.5.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.4",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "openapi-typescript": "^7.6.1",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.3.2"
  }
}
