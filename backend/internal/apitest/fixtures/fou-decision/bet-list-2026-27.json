     "sokdata": {
      "titel": "Stärkt skydd för demokratin och domstolarnas oberoende (vilande grundlagsförslag)",
      "undertitel": "Betänkande 2026/27:KU4",
      "soktyp": "",
      "statusrad": "\n<dl>\n\t<dt>Förslagspunkter</dt> <dd>1</dd><dt>Reservationer</dt> <dd>1 </dd><dt>Anföranden och repliker</dt> <dd>8 (47 minuter)</dd><dt>Justering</dt> <dd>2026-10-22</dd>\n\t<dt>Datum</dt> <dd>2026-10-23</dd>\n\t<dt>Bordläggning</dt> <dd>2026-11-03</dd><dt>Debatt</dt> <dd>2026-11-04</dd><dt>Beslut</dt> <dd>2026-11-04</dd>\n</dl>\n",
      "brodsmula": "",
      "parti_kod": "",
      "parti_namn": "",
      "parti_website_url": "",
      "parti_website_namn": "",
      "parti_epost": "",
